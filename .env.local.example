# Supabase public configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or expose them to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend) – server only
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=applications@mwaihub.com

# Optional future integrations
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
PAYCHANGU_SECRET_KEY=
# OPENAI_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CRON_SECRET=replace_with_a_long_random_secret

# Phase 6 – PayChangu (server-only)
PAYCHANGU_SECRET_KEY=your_paychangu_secret_key
PAYCHANGU_WEBHOOK_SECRET=your_paychangu_webhook_secret
# Configure this exact URL in PayChangu Settings > API & Webhooks:
# https://your-domain.example/api/payments/webhook
